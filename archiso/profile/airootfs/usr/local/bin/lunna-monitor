#!/usr/bin/env python3
import psutil
from PyQt6.QtCore import QTimer
from PyQt6.QtWidgets import QApplication,QWidget,QVBoxLayout,QLabel
app=QApplication([])
w=QWidget()
w.setWindowTitle("LunnaOS Monitor")
w.resize(520,260)
w.setStyleSheet("QWidget{background:#0a0714;color:#f7f3ff} QLabel{padding:12px;border:1px solid #8a2be2;border-radius:10px}")
lay=QVBoxLayout(w)
cpu=QLabel()
mem=QLabel()
disk=QLabel()
def tick():
    cpu.setText(f"CPU: {psutil.cpu_percent():.1f}%")
    m=psutil.virtual_memory()
    mem.setText(f"RAM: {m.percent:.1f}% ({m.used//(1024**3)} GiB / {m.total//(1024**3)} GiB)")
    d=psutil.disk_usage("/")
    disk.setText(f"Disco /: {d.percent:.1f}%")
timer=QTimer()
timer.timeout.connect(tick)
timer.start(1000)
for x in (cpu,mem,disk): lay.addWidget(x)
tick()
w.show()
app.exec()
